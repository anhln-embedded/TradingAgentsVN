# Copy to deploy/.env. Do not commit the real file.
APP_VERSION=local
APP_PORT=8000
POSTGRES_PASSWORD=
TA_BOOTSTRAP_ADMIN_EMAIL=superadmin
# At least 4 characters; creates the first superadmin only. Remove after setup.
TA_BOOTSTRAP_ADMIN_PASSWORD=
TA_ALLOW_REGISTRATION=true
TA_JOB_TIMEOUT=1800
# Reserved for later payment integration; intentionally left unconfigured.
TA_PAYMENT_PROVIDER=
# Required public HTTPS origin when exposing the production service.
TA_PUBLIC_ORIGIN=
# SSI MCP server-wide OAuth. Generate the Fernet key once and keep it secret.
# Callback must exactly match the public HTTPS URL configured with SSI OAuth.
SSI_MCP_REDIRECT_URI=
SSI_MCP_TOKEN_ENCRYPTION_KEY=
# Optional only for a pre-registered client; dynamic registration is the default.
SSI_MCP_CLIENT_ID=
SSI_MCP_CLIENT_SECRET=
# Debug only. Leave empty in production.
SSI_MCP_ACCESS_TOKEN=
# Official exchange closure dates, ISO and comma-separated.
VN_MARKET_HOLIDAYS=
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_LLM_BACKEND_URL=
OPENAI_COMPATIBLE_API_KEY=
TRADINGAGENTS_LLM_TIMEOUT=60
TRADINGAGENTS_LLM_MAX_RETRIES=4
